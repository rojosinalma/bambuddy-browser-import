{
  "manifest_version": 3,
  "name": "Bambuddy Browser Import",
  "version": "2.0.0",
  "description": "Import MakerWorld print profiles into your Bambuddy library — pick the plates, pick the folder, one click.",

  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://makerworld.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "64":  "icons/icon64.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Import into Bambuddy"
  },

  "options_page": "options.html",

  "content_scripts": [
    {
      "matches": ["https://makerworld.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "background.js"]
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "bambuddy-browser-import@rojosinalma.github.io",
      "strict_min_version": "128.0"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "64":  "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}
